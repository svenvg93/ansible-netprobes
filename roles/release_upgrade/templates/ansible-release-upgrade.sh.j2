#!/bin/bash
# {{ ansible_managed }}
# Runs one phase of the Ubuntu release upgrade. Started by Ansible with systemd-run, so it
# lives outside the SSH session: restarting tailscaled (which carries that session) can't
# kill it. Ansible polls <phase>.status until it reads "done <exit code>".
set -uo pipefail

phase="$1"
dir={{ release_upgrade_state_dir }}
mkdir -p "$dir"
echo running > "$dir/$phase.status"

export DEBIAN_FRONTEND=noninteractive
apt_opts=(-y -o DPkg::Lock::Timeout=600
          -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)

{
  echo "=== $(date -Is) phase: $phase"
  case "$phase" in
    # do-release-upgrade refuses to start with updates pending, Tailscale included.
    prepare) apt-get "${apt_opts[@]}" update &&
             apt-get "${apt_opts[@]}" dist-upgrade &&
             apt-get "${apt_opts[@]}" autoremove ;;
    upgrade) do-release-upgrade -f DistUpgradeViewNonInteractive ;;
    *)       echo "unknown phase: $phase"; false ;;
  esac
} >> "$dir/$phase.log" 2>&1

echo "done $?" > "$dir/$phase.status"
